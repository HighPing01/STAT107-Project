source("00_requirements.R")
data_23_24 <- read.csv("23_24.csv", fileEncoding = "UTF-8-BOM", check.names = FALSE)
top <- data_23_24[data_23_24$PTS >= 25, c("PLAYER", "PTS")]
top <- top[order(-top$PTS), ]
names(top) <- c("Player", "PPG")
dev.new(width = 10, height = 7)     # opens a big separate window
par(mar = c(9, 4, 4, 2))
plot(1:nrow(top), top$PPG,
xaxt = "n",
xlab = "", ylab = "Points per game (PPG)",
main = "Players Averaging 25+ PPG, 2023-24",
pch = 16, col = "steelblue", cex = 1.5,
ylim = c(24, max(top$PPG) + 1))
axis(1, at = 1:nrow(top), labels = top$Player, las = 2, cex.axis = 0.8)
graphics.off()
plot(1:nrow(top), top$PPG, xaxt = "n", xlab = "", ylab = "PPG", pch = 16)
data_23_24 <- read.csv("23_24.csv", fileEncoding = "UTF-8-BOM", check.names = FALSE)
# Keep only players with 25+ PPG, sorted highest to lowest
keep <- data_23_24[data_23_24$PTS >= 25, ]
keep <- keep[order(-keep$PTS), ]
# Build the matrix: one column of PPG, rows labeled by player name
top_mat <- matrix(keep$PTS, ncol = 1,
dimnames = list(keep$PLAYER, "PPG"))
top_mat   # check it: 18 rows, names on the left, PPG on the right
# Plot the two: names (from rownames) vs PPG (from the column)
par(mar = c(10, 4, 4, 2))
plot(1:nrow(top_mat), top_mat[, "PPG"],
xaxt = "n", xlab = "", ylab = "Points per game (PPG)",
main = "Players Averaging 25+ PPG, 2023-24",
pch = 16, col = "steelblue", cex = 1.5)
axis(1, at = 1:nrow(top_mat), labels = rownames(top_mat), las = 2, cex.axis = 0.8)
