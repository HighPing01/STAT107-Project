library(tidyverse)
library(scales)
library(ggrepel)
library(patchwork)
library(ggplot2)
library(dplyr)
library(tidyr)
height_to_cm <- function(heights) {
parts  <- strsplit(heights, "-")
feet   <- as.numeric(sapply(parts, `[`, 1))
inches <- as.numeric(sapply(parts, `[`, 2))
round((feet * 12 + inches) * 2.54, 1)
}
filter_elite <- function(data, ppg_col = "PTS", threshold = 25) {
out <- data[data[[ppg_col]] >= threshold, ]
out[order(-out[[ppg_col]]), ]
}
source("00_requirements.R")
source("01_funct_DataCleaning_Height_to_cm.R")
source("02_funct_DataCleaning_filterelitescorers.R")
load("12_DataSaving.RData")
#23/24 Data Cleaning Steps
nba_raw <- read.csv("23_24_Height.csv")
dim(nba_raw)
nba <- nba_raw[, c("PLAYER", "TEAM", "AGE", "HEIGHT", "WEIGHT", "GP", "PTS")]
colSums(is.na(nba))
nba$TEAM <- as.factor(nba$TEAM)
str(nba)
nba$height_cm <- height_to_cm(nba$HEIGHT)
nba$elite     <- nba$PTS >= 25
summary(nba$height_cm)
table(nba$elite)
elite <- filter_elite(nba, threshold = 25)
nrow(elite)
save(nba, elite, file = "12_DataSaving.RData")
