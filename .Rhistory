# Read in data, keeping only the columns we need
data_23_24 <- read.csv("23_24.csv", fileEncoding = "UTF-8-BOM", check.names = FALSE)
df <- data_23_24[, c("PLAYER", "TEAM", "AGE", "GP", "MIN", "PTS")]
names(df)[names(df) == "PTS"] <- "PPG"
# Optional: drop players with very few games, since their PPG is noisy
df <- df[df$GP >= 10, ]
df <- df[order(-df$PPG), ]   # sort highest to lowest PPG
head(df)
# 1) PPG vs player (all players, ranked)
# 500+ names can't fit on an axis, so plot rank on x and PPG on y
plot(seq_len(nrow(df)), df$PPG,
xlab = "Player rank (by PPG)", ylab = "Points per game",
main = "PPG by Player, 2023-24", pch = 16, col = "steelblue")
# 1b) Readable version: top 20 scorers with names
top20 <- head(df, 20)
par(mar = c(5, 11, 4, 2))   # wider left margin for names
dotchart(rev(top20$PPG), labels = rev(top20$PLAYER),
xlab = "Points per game", main = "Top 20 Scorers, 2023-24",
pch = 16, col = "steelblue")
par(mar = c(5, 4, 4, 2))    # reset margins
# 2) Scatter plots with variables you do have
plot(df$AGE, df$PPG, xlab = "Age", ylab = "PPG",
main = "PPG vs Age", pch = 16, col = "steelblue")
plot(df$MIN, df$PPG, xlab = "Minutes per game", ylab = "PPG",
main = "PPG vs Minutes", pch = 16, col = "steelblue")
abline(lm(PPG ~ MIN, data = df), col = "red", lwd = 2)
# 3) PPG by team (boxplot, since team is categorical)
par(mar = c(5, 4, 4, 2))
boxplot(PPG ~ TEAM, data = df, las = 2, cex.axis = 0.7,
ylab = "PPG", main = "PPG by Team")
# 3) PPG by team (boxplot, since team is categorical)
par(mar = c(5, 4, 4, 2))
boxplot(PPG ~ TEAM, data = df, las = 2, cex.axis = 0.7,
ylab = "PPG", main = "PPG by Team")
par(mar = c(5, 4, 4, 2))    # reset margins
