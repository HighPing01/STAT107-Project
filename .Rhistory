matmul1 <- function(A, B) {
m <- nrow(A)
n <- ncol(A)
p <- ncol(B)
C <- matrix(0, nrow = m, ncol = p)
for (i in 1:m) {
for (k in 1:p) {
for (j in 1:n) {
C[i, k] <- C[i, k] + A[i, j] * B[j, k]
}
}
}
return(C)
}
matmul2 <- function(A, B) {
m <- nrow(A)
n <- ncol(A)
p <- ncol(B)
C <- matrix(0, nrow = m, ncol = p)
for (k in 1:p) {
for (j in 1:n) {
C[, k] <- C[, k] + B[j, k] * A[, j]
}
}
return(C)
}
# DO NOT MODIFY
set.seed(1000)
A <- matrix(rnorm(1000 * 500), nrow = 1000, ncol = 500)
B <- matrix(rnorm(500 * 800), nrow = 500, ncol = 800)
## Your code here:
times <- list(
matmul1 = system.time(matmul1(A, B)),
matmul2 = system.time(matmul2(A, B)),
baseR   = system.time(A %*% B)
)
