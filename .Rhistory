y.sqrt <- function(c, x0, maxiter = 10, epsilon = 0.001) {
x <- x0
# counts iteration (+1)
iter <- 0
# stays false until condition met
converged <- FALSE
while (!converged && iter < maxiter) {
x <- 0.5 * (x + c / x)
# iteration
iter <- iter + 1
if (abs(x^2 - c) < epsilon) {
converged <- TRUE
}
}
cat("Iteration Total =", iter, "\n")
return(x)
}
my.sqrt(pi^2, 1, maxiter = 100)
my.sqrt <- function(c, x0, maxiter = 10, epsilon = 0.001) {
x <- x0
# counts iteration (+1)
iter <- 0
# stays false until condition met
converged <- FALSE
while (!converged && iter < maxiter) {
x <- 0.5 * (x + c / x)
# iteration
iter <- iter + 1
if (abs(x^2 - c) < epsilon) {
converged <- TRUE
}
}
cat("Iteration Total =", iter, "\n")
return(x)
}
my.sqrt(pi^2, 1, maxiter = 100)
