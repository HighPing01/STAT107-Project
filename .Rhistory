source("00_requirements.R")
source("01_funct_DataCleaning_Height_to_cm.R")
source("02_funct_DataCleaning_filterelitescorers.R")
load("12_DataSaving.RData")
#24/25
df <- read.csv("24_25_Height.csv")
df_processed <- df %>%
separate(HEIGHT, into = c("feet", "inches"), sep = "-",
convert = TRUE, remove = FALSE) %>%
mutate(HEIGHT_IN = feet * 12 + inches)
total_count <- nrow(df_processed)
short_count <- df_processed %>% filter(HEIGHT_IN < 77) %>% nrow()
percentage  <- (short_count / total_count) * 100
cat("\n=== 2024-2025 NBA Season Height Analysis ===\n")
cat("Total Players in Dataset:        ", total_count, "\n")
cat("Players Shorter than 6'5\":       ", short_count, "\n")
cat("Percentage Shorter than 6'5\":    ", round(percentage, 2), "%\n")
df_plot <- df_processed %>%
mutate(Group = ifelse(HEIGHT_IN < 77, "Shorter than 6'5\"", "6'5\" or taller")) %>%
count(Group) %>%
mutate(pct = n / sum(n) * 100)
ggplot(df_plot, aes(x = Group, y = pct, fill = Group)) +
geom_col(alpha = 0.8, width = 0.6) +
geom_text(aes(label = paste0(round(pct, 1), "% (", n, " players)")),
vjust = -0.5) +
scale_y_continuous(limits = c(0, 100)) +
labs(
title = "Percentage of NBA Players Shorter than 6'5\" (2024-25)",
x = NULL,
y = "Percentage of Players"
) +
theme_minimal() +
theme(legend.position = "none")
df <- read_csv("24_25.csv", skip = 1, col_names = c(
"RANK", "PLAYER", "TEAM", "AGE", "GP", "W", "L", "MIN", "PTS",
"FGM", "FGA", "FG%", "3PM", "3PA", "3P%", "FTM", "FTA", "FT%",
"OREB", "DREB", "REB", "AST", "TOV", "STL", "BLK", "PF",
"TFP", "HSFP", "DD2", "TD3", "+/-"
))
scorers_25 <- df %>% filter(PTS >= 25)
cat("Players averaging 25+ PPG:", nrow(scorers_25), "\n")
ggplot(scorers_25, aes(x = reorder(PLAYER, PTS), y = PTS, fill = PTS)) +
geom_col() +
geom_text(aes(label = PTS), hjust = -0.2) +
coord_flip() +
scale_y_continuous(limits = c(0, 36)) +
scale_fill_gradient(low = "skyblue", high = "steelblue") +
labs(
title = "NBA Players Averaging 25+ Points Per Game (2024-25)",
x = NULL,
y = "Points Per Game (PPG)"
) +
theme_minimal() +
theme(legend.position = "none")
