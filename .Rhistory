stats$KEY <- toupper(trimws(stats$PLAYER))
cat("keys matching:", sum(nba$KEY %in% stats$KEY), "\n")
merged <- merge(nba, stats[, c("KEY", "MIN")], by = "KEY")
cat("merged:", nrow(merged), "\n")
cat("PTS class:", class(nba$PTS), "\n")
cat("players >= 25 PPG:", sum(nba$PTS >= 25, na.rm = TRUE), "\n")
cat("filter_elite on nba:", nrow(filter_elite(nba, threshold = 25)), "\n")
