my_fibonacci1 <- function(t) {
if (!is.integer(t) || length(t) != 1 || is.na(t) || t <= 0L) {
print("Error: input does not conform to required format")
return(-1)
}
if (t <= 2L) {
return(1)
}
f_prev <- 1
f_curr <- 1
for (k in 3:t) {
f_next <- f_curr + f_prev
f_prev <- f_curr
f_curr <- f_next
}
return(f_curr)
}
myfibo1 <- numeric(25)
for (t in 1L:25L) {
myfibo1[t] <- my_fibonacci1(t)
}
print(myfibo1)
my_fibonacci2 <- function(t) {
if (!is.integer(t) || any(is.na(t)) || any(t <= 0L)) {
print("Error: input does not conform to required format")
return(-1)
}
phi <- (1 + sqrt(5)) / 2
fib <- (phi^t - (-1 / phi)^t) / sqrt(5)
return(round(fib))
}
myfibo2 <- my_fibonacci2(1L:25L)
print(myfibo2)
