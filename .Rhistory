y.sqrt.iterates <- function(c, x0, maxiter = 10, epsilon = 0.001) {
# Current estimate of the square root, initialized with the guess
x <- x0
iter <- 0
converged <- FALSE
iterates <- numeric(0)
while (!converged && iter < maxiter) {
x <- 0.5 * (x + c / x)
iter <- iter + 1
iterates[iter] <- x
if (abs(x^2 - c) < epsilon) {
converged <- TRUE
}
}
cat("Iteration Total =", iter, "\n")
return(iterates)
}
iterates <- my.sqrt.iterates(c = 400, x = 1000, maxit = 1000, epsilon = 0.001)
my.sqrt.iterates <- function(c, x0, maxiter = 10, epsilon = 0.001) {
# Current estimate of the square root, initialized with the guess
x <- x0
iter <- 0
converged <- FALSE
iterates <- numeric(0)
while (!converged && iter < maxiter) {
x <- 0.5 * (x + c / x)
iter <- iter + 1
iterates[iter] <- x
if (abs(x^2 - c) < epsilon) {
converged <- TRUE
}
}
cat("Iteration Total =", iter, "\n")
return(iterates)
}
iterates <- my.sqrt.iterates(c = 400, x = 1000, maxit = 1000, epsilon = 0.001)
plot(seq_along(iterates), iterates,
type = "b", pch = 19, col = "blue",
xlab = "Iteration Index",
ylab = "Iteration Value",
main = "Babylonian Method: Convergence")
abline(h = sqrt(400), col = "red", lwd = 2)
legend("topright",
legend = c("Iterates", "True square root (20)"),
col    = c("blue", "red"),
pch    = c(19, NA),
lty    = c(1, 1),
lwd    = c(1, 2))
