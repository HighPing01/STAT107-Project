ggplot(df_plot, aes(x = Group, y = pct, fill = Group)) +
geom_col(alpha = 0.8, width = 0.6) +
geom_text(aes(label = paste0(round(pct, 1), "% (", n, " players)")),
vjust = -0.5) +
scale_y_continuous(limits = c(0, 100)) +
labs(
title = "Percentage of NBA Players Shorter than 6'5\" (2024-25)",
x = NULL,
y = "Percentage of Players"
) +
theme_minimal() +
theme(legend.position = "none")
